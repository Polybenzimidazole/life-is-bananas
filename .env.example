# Optional overrides for the Project 4 and Deel 5 Compose stacks.
# Copy to .env in the repository root before changing values.
FRONTEND_PORT=8081
BACKEND_PORT=8080
PROJECT4_DB_USER=admin
PROJECT4_DB_PASSWORD=Admin123
PROJECT4_DB_ROOT_PASSWORD=project4-local-root
DEEL5_FRONTEND_PORT=8085
DEEL5_BACKEND_PORT=8084
DEEL5_ADMIN_PORT=8086
DEEL5_DB_PASSWORD=Admin123
DEEL5_DB_ROOT_PASSWORD=deel5-local-root

# Deel 5 AI: zet AI_CHAT_PROVIDER op openai en vul je eigen serversleutel in.
AI_CHAT_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
